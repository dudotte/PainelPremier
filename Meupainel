// ═══ VISÃO GERAL PANEL ══════════════════════════════════════════════
function GeralPanel({month,setMonth}){
  const [mpMd]=useMonthData("mp",month);
  const [ctMd]=useMonthData("ct",month);
  const mpM=useMemo(()=>calcMetrics("mp",month,mpMd),[mpMd,month]);
  const ctM=useMemo(()=>calcMetrics("ct",month,ctMd),[ctMd,month]);
  const combined=mpM.totalRev+ctM.totalRev;
  const combinedMeta=(mpMd.meta||META_DEFAULT)+(ctMd.meta||META_DEFAULT);
  const combinedPct=Math.min(100,combined/combinedMeta*100);

  // Annual summary (load each month summary from stored data — approximate with just showing whatever we can)
  const [annualData,setAnnualData]=useState({});
  useEffect(()=>{
    const load=async()=>{
      const result={};
      for(let m=1;m<=12;m++){
        const mpd=await stor(sk("mp",m),null);
        const ctd=await stor(sk("ct",m),null);
        const mpInit=mpd||initMonth("mp",m);
        const ctInit=ctd||initMonth("ct",m);
        const mpM2=calcMetrics("mp",m,mpInit);
        const ctM2=calcMetrics("ct",m,ctInit);
        result[m]={mpRev:mpM2.totalRev,ctRev:ctM2.totalRev,total:mpM2.totalRev+ctM2.totalRev,pct:Math.min(100,(mpM2.totalRev+ctM2.totalRev)/(combinedMeta)*100)};
      }
      setAnnualData(result);
    };
    load();
  },[]);

  return(
    <div>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:16,flexWrap:"wrap",gap:10}}>
        <MonthNav month={month} setMonth={setMonth}/>
      </div>

      {/* Month consolidated */}
      <div style={{background:"linear-gradient(135deg,rgba(201,170,39,.08),rgba(96,165,250,.08))",border:"1px solid rgba(255,255,255,.08)",borderRadius:18,padding:"18px 16px",marginBottom:16}}>
        <p style={{fontSize:9,color:"#888",letterSpacing:3,margin:"0 0 12px",fontWeight:600}}>CONSOLIDADO {MN[month-1].toUpperCase()} — DUAS UNIDADES</p>
        <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:10,marginBottom:14}}>
          {[
            {l:"Total acumulado",v:fmt(combined),c:"#22c55e"},
            {l:"Total a faturar",v:fmt(combinedMeta-combined),c:"#ef4444"},
            {l:"% da meta total",v:combinedPct.toFixed(0)+"%",c:"#C9AA27"},
          ].map(({l,v,c})=>(
            <div key={l} style={{background:"rgba(0,0,0,.3)",borderRadius:10,padding:"12px 10px",textAlign:"center"}}>
              <p style={{fontSize:9,color:"#777",margin:"0 0 4px"}}>{l}</p>
              <p style={{fontSize:17,fontWeight:800,color:c,margin:0}}>{v}</p>
            </div>
          ))}
        </div>
        <ProgBar pct={combinedPct} color="linear-gradient(90deg,#C9AA27,#60a5fa)"/>
      </div>

      {/* Per store */}
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,marginBottom:20}}>
        {[{sid:"mp",m:mpM,md:mpMd},{sid:"ct",m:ctM,md:ctMd}].map(({sid,m,md})=>{
          const cfg=STORES[sid];
          return(
            <div key={sid} style={{background:"rgba(255,255,255,.04)",border:"1px solid rgba(255,255,255,.08)",borderRadius:16,padding:"16px 14px",borderTop:"3px solid "+cfg.color}}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12}}>
                <div>
                  <p style={{fontWeight:700,fontSize:14,margin:0,color:cfg.color}}>{cfg.icon} {cfg.name}</p>
                  <p style={{fontSize:10,color:"#666",margin:"2px 0 0"}}>{cfg.sellers.join(" · ")}</p>
                </div>
                <div style={{position:"relative",flexShrink:0}}>
                  <Ring pct={m.pct} size={65} stroke={6} color={cfg.color}/>
                  <div style={{position:"absolute",inset:0,display:"flex",alignItems:"center",justifyContent:"center"}}>
                    <span style={{fontSize:12,fontWeight:800,color:cfg.color}}>{m.pct.toFixed(0)}%</span>
                  </div>
                </div>
              </div>
              {[
                {l:"Acumulado",v:fmt(m.totalRev),c:"#22c55e"},
                {l:"Falta",v:fmt(m.rem),c:"#ef4444"},
                {l:"Meta/dia",v:fmt(m.dailyGoal),c:cfg.color},
                {l:"Por vendedora",v:fmt(m.perSeller),c:"#fb923c"},
                {l:"Dias úteis",v:m.dLeft+" dias",c:"#a78bfa"},
              ].map(({l,v,c})=>(
                <div key={l} style={{display:"flex",justifyContent:"space-between",borderBottom:"1px solid rgba(255,255,255,.05)",paddingBottom:6,marginBottom:6}}>
                  <span style={{fontSize:11,color:"#888"}}>{l}</span>
                  <span style={{fontWeight:700,color:c,fontSize:12}}>{v}</span>
                </div>
              ))}
            </div>
          );
        })}
      </div>

      {/* Annual summary */}
      <div>
        <p style={{fontSize:9,color:"#888",letterSpacing:2,margin:"0 0 10px",fontWeight:600}}>📅 RESUMO ANUAL 2026</p>
        <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fill,minmax(100px,1fr))",gap:6}}>
          {Array.from({length:12},(_,i)=>i+1).map(m=>{
            const ad=annualData[m]||{total:0,pct:0};
            const isCurrentM=m===TM, isFuture=m>TM;
            return(
              <div key={m} style={{background:isCurrentM?"rgba(201,170,39,.1)":isFuture?"rgba(255,255,255,.02)":"rgba(255,255,255,.04)",
                border:"1px solid "+(isCurrentM?"rgba(201,170,39,.3)":"rgba(255,255,255,.07)"),borderRadius:10,padding:"10px 8px",textAlign:"center",cursor:"pointer"}}
                onClick={()=>setMonth(m)}>
                <p style={{fontSize:10,fontWeight:700,color:isCurrentM?"#C9AA27":isFuture?"#555":"#aaa",margin:"0 0 4px"}}>{["Jan","Fev","Mar","Abr","Mai","Jun","Jul","Ago","Set","Out","Nov","Dez"][m-1]}</p>
                {!isFuture&&<p style={{fontSize:12,fontWeight:700,color:ad.pct>=100?"#22c55e":ad.pct>50?"#C9AA27":"#888",margin:"0 0 4px"}}>{ad.pct.toFixed(0)}%</p>}
                {!isFuture&&ad.total>0&&<p style={{fontSize:9,color:"#555",margin:0}}>{fmt(ad.total/1000).replace("R$","")+"k"}</p>}
                {isFuture&&<p style={{fontSize:10,color:"#444",margin:0}}>—</p>}
                {isCurrentM&&<p style={{fontSize:8,color:"#C9AA27",margin:"2px 0 0",fontWeight:600}}>ATUAL</p>}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}

// ═══ CONSULTAS PANEL ══════════════════════════════════════════════
function ConsultasPanel(){
  const [consults,setConsults]=useState(SEED_CONSULTS);
  const [showAdd,setShowAdd]=useState(false);
  const [editId,setEditId]=useState(null);
  const [newC,setNewC]=useState({store:"mp",date:"",dow:"",day:"",month:TM,agendadas:0,realizadas:0,rev:0,revVenda:0});

  useEffect(()=>{ stor("pc4-consults",null).then(d=>d&&setConsults(d)); },[]);
  const persist=useCallback(d=>stow("pc4-consults",d),[]);

  const upd=(id,field,val)=>{
    const next=consults.map(c=>c.id===id?{...c,[field]:parseFloat(val)||val}:c);
    setConsults(next); persist(next);
  };
  const add=()=>{
    const id="c"+Date.now();
    const next=[...consults,{...newC,id,agendadas:+newC.agendadas||0,realizadas:+newC.realizadas||0,rev:parseFloat(String(newC.rev).replace(",","."))||0,revVenda:parseFloat(String(newC.revVenda).replace(",","."))||0}];
    setConsults(next); persist(next);
    setNewC({store:"mp",date:"",dow:"",day:"",month:TM,agendadas:0,realizadas:0,rev:0,revVenda:0});
    setShowAdd(false);
  };
  const remove=id=>{ const next=consults.filter(c=>c.id!==id); setConsults(next); persist(next); };

  const byStore=s=>consults.filter(c=>c.store===s);
  const storeStats=s=>{
    const cs=byStore(s);
    return {
      agend:cs.reduce((a,b)=>a+(+b.agendadas||0),0),
      realiz:cs.reduce((a,b)=>a+(+b.realizadas||0),0),
      rev:cs.reduce((a,b)=>a+(+b.rev||0),0),
      revV:cs.reduce((a,b)=>a+(+b.revVenda||0),0),
    };
  };

  const storeColor={mp:"#C9AA27",ct:"#60a5fa"};
  const storeName={mp:"🌊 Meia Praia",ct:"🏢 Centro"};

  const inStyle={background:"rgba(255,255,255,.06)",border:"1px solid rgba(255,255,255,.12)",borderRadius:8,color:"#f5f5f5",padding:"6px 10px",fontSize:12,fontFamily:"inherit",outline:"none",boxSizing:"border-box",width:"100%"};

  return(
    <div>
      <div style={{background:"rgba(255,255,255,.03)",border:"1px solid rgba(255,255,255,.08)",borderRadius:14,padding:"14px 16px",marginBottom:16}}>
        <p style={{fontSize:9,color:"#a78bfa",letterSpacing:3,margin:"0 0 8px",fontWeight:600}}>👩‍⚕️ RESPONSÁVEIS — JAQUE & JESSICA</p>
        <p style={{fontSize:12,color:"#ccc",margin:0,lineHeight:1.7}}>Fazem os agendamentos e acompanham as consultas nas duas unidades. <strong style={{color:"#ef4444"}}>Não participam da meta de vendas.</strong> Meta: <strong style={{color:"#a78bfa"}}>52 consultas/mês</strong> · 26 por unidade.</p>
      </div>

      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,marginBottom:20}}>
        {["mp","ct"].map(s=>{
          const st=storeStats(s); const conv=st.agend>0?st.realiz/st.agend*100:0;
          return(
            <div key={s} style={{background:"rgba(255,255,255,.04)",border:"1px solid rgba(255,255,255,.08)",borderRadius:14,padding:"16px 14px",borderTop:"3px solid "+storeColor[s]}}>
              <p style={{fontSize:10,color:storeColor[s],letterSpacing:2,margin:"0 0 12px",fontWeight:700}}>{storeName[s]}</p>
              {[
                {l:"Agendadas",v:st.agend,c:"#a78bfa"},
                {l:"Realizadas",v:st.realiz,c:storeColor[s]},
                {l:"Conversão",v:fmtPct(conv),c:conv>=70?"#22c55e":conv>=40?"#fbbf24":"#ef4444"},
                {l:"Fat. consulta",v:fmt(st.rev),c:"#22c55e"},
                {l:"Fat. venda",v:fmt(st.revV),c:"#fb923c"},
              ].map(({l,v,c})=>(
                <div key={l} style={{display:"flex",justifyContent:"space-between",borderBottom:"1px solid rgba(255,255,255,.05)",paddingBottom:6,marginBottom:6}}>
                  <span style={{fontSize:11,color:"#888"}}>{l}</span>
                  <span style={{fontWeight:700,color:c,fontSize:12}}>{v}</span>
                </div>
              ))}
              <ProgBar pct={conv} color={storeColor[s]} height={4}/>
              <p style={{fontSize:9,color:"#555",margin:"4px 0 0"}}>{conv.toFixed(0)}% de conversão</p>
            </div>
          );
        })}
