          </div>
          <div style={{display:"flex",gap:8}}>
            <button onClick={add} style={{background:"#22c55e",color:"#000",border:"none",borderRadius:99,padding:"7px 18px",fontSize:12,fontWeight:700,cursor:"pointer",fontFamily:"inherit"}}>Salvar</button>
            <button onClick={()=>setShowAdd(false)} style={{background:"rgba(255,255,255,.06)",color:"#aaa",border:"none",borderRadius:99,padding:"7px 18px",fontSize:12,cursor:"pointer",fontFamily:"inherit"}}>Cancelar</button>
          </div>
        </div>
      )}

      <div style={{display:"flex",flexDirection:"column",gap:8}}>
        {[...consults].sort((a,b)=>(a.month*100+a.day)-(b.month*100+b.day)).map(c=>{
          const isEdit=editId===c.id;
          const conv=c.agendadas>0?((+c.realizadas||0)/(+c.agendadas||1)*100):0;
          const isOrig=SEED_CONSULTS.some(s=>s.id===c.id);
          return(
            <div key={c.id} style={{background:"rgba(255,255,255,.04)",border:"1px solid rgba(255,255,255,.08)",borderRadius:12,padding:"14px 16px"}}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",flexWrap:"wrap",gap:8}}>
                <div style={{display:"flex",gap:12,alignItems:"center"}}>
                  <div>
                    <p style={{fontSize:16,fontWeight:800,margin:0}}>{c.date}</p>
                    <p style={{fontSize:10,color:"#666",margin:0}}>{c.dow}</p>
                  </div>
                  <span style={{fontSize:9,padding:"3px 9px",borderRadius:99,fontWeight:700,
                    background:c.store==="mp"?"rgba(201,170,39,.15)":"rgba(96,165,250,.15)",
                    color:c.store==="mp"?"#C9AA27":"#60a5fa",
                    border:"1px solid "+(c.store==="mp"?"rgba(201,170,39,.3)":"rgba(96,165,250,.3)")}}>
                    {c.store==="mp"?"Meia Praia":"Centro"}
                  </span>
                </div>
                <div style={{display:"flex",gap:8,alignItems:"center"}}>
                  {isEdit?(
                    <div style={{display:"grid",gridTemplateColumns:"repeat(2,1fr)",gap:6,minWidth:280}}>
                      {[["agendadas","Agendadas"],["realizadas","Realizadas"],["rev","Fat. consulta"],["revVenda","Fat. venda"]].map(([f,l])=>(
                        <div key={f}>
                          <p style={{fontSize:9,color:"#888",margin:"0 0 3px"}}>{l}</p>
                          <input defaultValue={c[f]} onChange={e=>upd(c.id,f,e.target.value)}
                            style={{...inStyle,padding:"5px 8px",fontSize:12}}/>
                        </div>
                      ))}
                    </div>
                  ):(
                    <div style={{display:"flex",gap:12,alignItems:"center",flexWrap:"wrap"}}>
                      <div style={{textAlign:"center"}}>
                        <p style={{fontSize:9,color:"#888",margin:0}}>Agend.</p>
                        <p style={{fontSize:18,fontWeight:800,color:"#a78bfa",margin:0}}>{c.agendadas||0}</p>
                      </div>
                      <div style={{textAlign:"center"}}>
                        <p style={{fontSize:9,color:"#888",margin:0}}>Realiz.</p>
                        <p style={{fontSize:18,fontWeight:800,color:"#22c55e",margin:0}}>{c.realizadas||0}</p>
                      </div>
                      <div style={{textAlign:"center"}}>
                        <p style={{fontSize:9,color:"#888",margin:0}}>Conv.</p>
                        <p style={{fontSize:14,fontWeight:700,color:conv>=70?"#22c55e":conv>=40?"#fbbf24":"#888",margin:0}}>{conv.toFixed(0)}%</p>
                      </div>
                      {(c.rev>0||c.revVenda>0)&&<div style={{textAlign:"center"}}>
                        <p style={{fontSize:9,color:"#888",margin:0}}>Faturado</p>
                        <p style={{fontSize:12,fontWeight:700,color:"#22c55e",margin:0}}>{fmt((+c.rev||0)+(+c.revVenda||0))}</p>
                      </div>}
                    </div>
                  )}
                  <div style={{display:"flex",gap:6,flexShrink:0}}>
                    <button onClick={()=>setEditId(isEdit?null:c.id)} style={{
                      background:isEdit?"#C9AA27":"rgba(255,255,255,.06)",color:isEdit?"#000":"#aaa",
                      border:"none",borderRadius:8,padding:"6px 12px",fontSize:11,cursor:"pointer",fontFamily:"inherit",fontWeight:600
                    }}>{isEdit?"✓ Ok":"✏️"}</button>
                    {!isOrig&&<button onClick={()=>remove(c.id)} style={{background:"rgba(239,68,68,.1)",color:"#ef4444",border:"1px solid rgba(239,68,68,.2)",borderRadius:8,padding:"6px 10px",fontSize:11,cursor:"pointer",fontFamily:"inherit"}}>✕</button>}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

