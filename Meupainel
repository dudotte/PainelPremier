// ═══ VENDAS TAB ══════════════════════════════════════════════
function VendasTab({sid,month,md,metrics}){
  const [data,setData]=md;
  const cfg=STORES[sid];
  const {dGoals}=metrics;
  const allWD=wDays(month);
  const filled=allWD.filter(d=>getTotal(data.sales[d])>0||data.status[d]).length;

  const updSale=(day,sale)=>setData(d=>({...d,sales:{...d.sales,[day]:sale}}));
  const updStatus=(day,st)=>setData(d=>{
    const ns={...d.status};
    if(st===null||st===undefined)delete ns[day]; else ns[day]=st;
    return {...d,status:ns};
  });

  return(
    <div>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12,flexWrap:"wrap",gap:8}}>
        <p style={{color:"#888",fontSize:12,margin:0}}>Clique em qualquer dia para expandir. ✏️ Todos os dias são editáveis.</p>
        <span style={{fontSize:10,color:"#555"}}>{filled}/{allWD.length} dias lançados</span>
      </div>
      <div style={{display:"flex",flexDirection:"column",gap:8}}>
        {allWD.map(d=>(
          <DayCard key={d} day={d} month={month} sale={data.sales[d]} status={data.status[d]}
            cfg={cfg} goal={dGoals[d]||0}
            onUpdate={sale=>updSale(d,sale)} onStatus={st=>updStatus(d,st)}/>
        ))}
      </div>
    </div>
  );
}

