}

// ═══ DAY CARD ══════════════════════════════════════════════
function DayCard({day,month,sale,status,cfg,goal,onUpdate,onStatus}){
  const [open,setOpen]=useState(false);
  const total=getTotal(sale);
  const isFechada=status==="fechada";
  const isToday=month===TM&&day===TD;
  const isPast=month<TM||(month===TM&&day<TD);
  const diff=goal>0&&(total>0||status==="semvenda")?total-goal:null;
  const d=dowOf(day,month);

  const statBg={venda:cfg.bg,fechada:"rgba(239,68,68,.08)",semvenda:"rgba(99,102,241,.08)"}[status]||"rgba(255,255,255,.03)";
  const statBorder={venda:cfg.color+"55",fechada:"rgba(239,68,68,.3)",semvenda:"rgba(99,102,241,.3)"}[status]||"rgba(255,255,255,.08)";

  return(
    <div style={{background:statBg,border:"1px solid "+statBorder,borderRadius:12,padding:"11px 12px",opacity:isPast&&!total&&!status?0.5:1}}>
      <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",cursor:!isFechada?"pointer":"default"}}
        onClick={()=>!isFechada&&setOpen(!open)}>
        <div style={{display:"flex",alignItems:"center",gap:8}}>
          <span style={{fontSize:11,fontWeight:700,color:"#ccc"}}>{d} {day}/{String(month).padStart(2,"0")}</span>
          {isToday&&<span style={{fontSize:9,background:cfg.color,color:"#000",borderRadius:99,padding:"1px 7px",fontWeight:800}}>HOJE</span>}
        </div>
        <div style={{display:"flex",alignItems:"center",gap:8}}>
          {diff!==null&&<span style={{fontSize:10,fontWeight:700,color:diff>=0?"#22c55e":"#ef4444"}}>{diff>=0?"+":""}{fmt(diff)}</span>}
          {total>0&&<span style={{fontSize:13,fontWeight:800,color:cfg.color}}>{fmt(total)}</span>}
          {isFechada&&<span style={{fontSize:10,color:"#ef4444"}}>FECHADA</span>}
          {!isFechada&&<span style={{color:"#555",fontSize:12}}>{open?"▲":"▼"}</span>}
        </div>
      </div>
      {goal>0&&!open&&<p style={{fontSize:9,color:"#555",margin:"3px 0 0"}}>Meta do dia: {fmt(goal)}</p>}

      {open&&!isFechada&&(
        <div style={{marginTop:12,borderTop:"1px solid rgba(255,255,255,.07)",paddingTop:12}}>
          <p style={{fontSize:10,color:"#888",margin:"0 0 10px",letterSpacing:1}}>VENDA POR VENDEDORA</p>
          {cfg.sellers.map(s=>{
            const sv=sale?.sellers?.[s]||"";
            return(
              <div key={s} style={{display:"flex",alignItems:"center",gap:8,marginBottom:8}}>
                <span style={{fontSize:12,color:"#aaa",minWidth:85,flexShrink:0}}>{s}</span>
                <input value={sv===0&&!sv?"":String(sv).replace(".",",")} onChange={e=>{
                  const v=e.target.value.replace(/[^0-9,]/g,"");
                  const num=parseFloat(v.replace(",","."))||0;
                  onUpdate({sellers:{...(sale?.sellers||{}),[s]:num},manualTotal:0});
                }} placeholder="R$ 0,00" style={{
                  flex:1,background:"rgba(255,255,255,.06)",border:"1px solid rgba(255,255,255,.12)",
                  borderRadius:8,color:"#f5f5f5",padding:"6px 10px",fontSize:13,fontFamily:"inherit",outline:"none"
                }}/>
              </div>
            );
          })}
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"8px 0",borderTop:"1px solid rgba(255,255,255,.06)"}}>
            <span style={{fontSize:11,color:"#888"}}>Total automático</span>
            <span style={{fontSize:15,fontWeight:800,color:cfg.color}}>{fmt(Object.values(sale?.sellers||{}).reduce((a,b)=>a+(parseFloat(b)||0),0))}</span>
          </div>
          <div style={{marginBottom:10}}>
            <p style={{fontSize:10,color:"#666",margin:"0 0 4px"}}>Ou editar total manualmente:</p>
            <input value={sale?.manualTotal>0?String(sale.manualTotal).replace(".",","):""} onChange={e=>{
              const v=parseFloat(e.target.value.replace(/[^0-9,]/g,"").replace(",","."))||0;
              onUpdate({sellers:sale?.sellers||{},manualTotal:v});
            }} placeholder={"Auto: "+fmt(Object.values(sale?.sellers||{}).reduce((a,b)=>a+(parseFloat(b)||0),0))} style={{
              width:"100%",background:"rgba(255,255,255,.04)",border:"1px dashed rgba(255,255,255,.15)",
              borderRadius:8,color:"#f5f5f5",padding:"6px 10px",fontSize:12,fontFamily:"inherit",outline:"none",boxSizing:"border-box"
            }}/>
          </div>
          <div style={{display:"flex",gap:6}}>
            {["venda","semvenda","fechada"].map(st=>(
              <button key={st} onClick={()=>{ onStatus(st); if(st!=="venda"){ onUpdate({sellers:{},manualTotal:0}); } setOpen(false); }} style={{
                flex:1,padding:"7px 4px",fontSize:10,borderRadius:8,cursor:"pointer",fontFamily:"inherit",fontWeight:600,border:"none",
                background:status===st?{venda:cfg.color,semvenda:"#6366f1",fechada:"#ef4444"}[st]:"rgba(255,255,255,.07)",
                color:status===st?"#000":"#888",
              }}>{st==="venda"?"✓ Venda":st==="semvenda"?"○ Sem venda":"✕ Fechada"}</button>
            ))}
          </div>
        </div>
      )}
      {isFechada&&(
        <div style={{marginTop:4}}>
          <button onClick={()=>onStatus(null)} style={{fontSize:10,color:"#888",background:"none",border:"none",cursor:"pointer",fontFamily:"inherit"}}>Reabrir dia</button>
        </div>
      )}
    </div>
  );
}

