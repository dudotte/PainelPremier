// ═══ UTILS ══════════════════════════════════════════════
const fmt   = v => new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(v||0);
const fmtPct= v => (+(v||0)).toFixed(1)+"%";
const dIn   = m => new Date(YEAR,m,0).getDate();
const wDays = m => Array.from({length:dIn(m)},(_,i)=>i+1).filter(d=>new Date(YEAR,m-1,d).getDay()!==0);
const dowOf = (d,m)=> DOW_PT[new Date(YEAR,m-1,d).getDay()];
const sk    = (sid,m)=>`pc4-${sid}-${YEAR}-${String(m).padStart(2,"0")}`;

function getTotal(s){ if(!s)return 0; if(s.manualTotal>0)return s.manualTotal; return Object.values(s.sellers||{}).reduce((a,b)=>a+(parseFloat(b)||0),0); }

function initMonth(sid,m){
  const sales={}, status={};
  if(m===4){
    Object.entries(SEED_SALES[sid]).forEach(([d,v])=>{ sales[+d]={sellers:{},manualTotal:v}; });
    SEED_CLOSED[sid].forEach(d=>{ status[d]="fechada"; });
  }
  return {sales,status,appts:{},scenario:{val:"10000",day:15},meta:META_DEFAULT};
}

function calcMetrics(sid,m,md){
  const cfg=STORES[sid];
  const {sales={},status={},meta=META_DEFAULT}=md;
  const allWD=wDays(m);
  const effWD=allWD.filter(d=>status[d]!=="fechada");
  const totalRev=effWD.reduce((s,d)=>s+getTotal(sales[d]),0);
  const rem=Math.max(0,meta-totalRev);
  const pct=Math.min(100,totalRev/meta*100);
  const isCur=m===TM, isPast=m<TM;
  const done=new Set(effWD.filter(d=>status[d]==="semvenda"||getTotal(sales[d])>0));
  let dLeft;
  if(isPast) dLeft=0;
  else if(isCur) dLeft=Math.max(1,effWD.filter(d=>d>=TD&&!done.has(d)).length);
  else dLeft=Math.max(1,effWD.filter(d=>!done.has(d)).length);
  const dailyGoal=rem/Math.max(1,dLeft);
  const perSeller=dailyGoal/cfg.sellers.length;
  // Rolling goals per day
  const dGoals={};
  let r=meta;
  effWD.forEach((d,i)=>{ dGoals[d]=r/Math.max(1,effWD.length-i); r=Math.max(0,r-getTotal(sales[d])); });
  // Seller totals
  const sTots={};
  cfg.sellers.forEach(s=>sTots[s]=0);
  Object.values(sales).forEach(s2=>{ Object.entries(s2?.sellers||{}).forEach(([n,v])=>{ sTots[n]=(sTots[n]||0)+(parseFloat(v)||0); }); });
  const ranking=Object.entries(sTots).sort((a,b)=>b[1]-a[1]).map(([name,total],i)=>({name,total,rank:i+1,contrib:totalRev>0?total/totalRev*100:0}));
  return {totalRev,rem,pct,dLeft,dailyGoal,perSeller,meta,effWD,allWD,dGoals,ranking,sTots};
}

// ═══ STORAGE ══════════════════════════════════════════════
async function stor(key,fallback){ try{ const r=await window.storage.get(key); return r?JSON.parse(r.value):fallback; }catch{ return fallback; } }
async function stow(key,data){ try{ await window.storage.set(key,JSON.stringify(data)); }catch{} }

// ═══ HOOK ══════════════════════════════════════════════
function useMonthData(sid,month){
  const key=sk(sid,month);
  const [data,setRaw]=useState(null);
  useEffect(()=>{ stor(key,null).then(d=>setRaw(d||initMonth(sid,month))); },[key]);
  const setData=useCallback(upd=>setRaw(prev=>{
    const cur=prev||initMonth(sid,month);
    const next=typeof upd==="function"?upd(cur):upd;
    stow(key,next); return next;
  }),[key]);
  return [data||initMonth(sid,month),setData];
}

// ═══ SMALL COMPONENTS ══════════════════════════════════════════════
function Ring({pct,size=120,stroke=9,color="#C9AA27"}){
  const r=(size-stroke)/2, c=2*Math.PI*r;
  const off=c-(Math.min(100,Math.max(0,pct))/100)*c;
  return(
    <svg width={size} height={size} style={{transform:"rotate(-90deg)",flexShrink:0}}>
      <circle cx={size/2} cy={size/2} r={r} fill="none" stroke="rgba(255,255,255,.08)" strokeWidth={stroke}/>
      <circle cx={size/2} cy={size/2} r={r} fill="none" stroke={color} strokeWidth={stroke}
        strokeDasharray={c} strokeDashoffset={off} strokeLinecap="round" style={{transition:"stroke-dashoffset 1s"}}/>
    </svg>
  );
}

